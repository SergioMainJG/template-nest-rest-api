{
  "name": "template",
  "version": "0.0.1",
  "private": true,
  "description": "Plantilla de API con NestJS + Fastify sobre Bun, Drizzle (PostgreSQL con Bun SQL), cache en Redis y JWT.",
  "license": "MIT",
  "author": "Sergio Elias Arce Roldán",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "nest start --exec bun",
    "start:dev": "nest start --watch --exec bun",
    "start:debug": "nest start --debug --watch --exec bun",
    "start:prod": "bun dist/main.js",
    "test": "bun --bun vitest run --project unit",
    "test:watch": "bun --bun vitest --project unit",
    "test:int": "bun --bun vitest run --project integration",
    "test:e2e": "bun --bun vitest run --project e2e",
    "test:all": "bun --bun vitest run",
    "test:cov": "bun --bun vitest run --coverage",
    "test:debug": "bun --bun vitest --inspect-brk --no-file-parallelism",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:migrate": "bun src/migrate.ts",
    "db:studio": "bun --bun drizzle-kit studio",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "check": "oxfmt --check && oxlint",
    "typecheck": "bun --bun tsc --noEmit",
    "typecheck:watch": "bun --bun tsc --noEmit --watch --preserveWatchOutput",
    "prepare": "simple-git-hooks",
    "migrate:prod": "bun dist/migrate.js"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/static": "10.1.4",
    "@keyv/redis": "5.1.6",
    "@nestjs/cache-manager": "12.0.0",
    "@nestjs/common": "12.0.1",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/drizzle": "0.0.1",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/observe": "0.1.8",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-fastify": "12.1.0",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/throttler": "6.7.1",
    "@scalar/nestjs-api-reference": "1.2.23",
    "arktype": "2.2.5",
    "cache-manager": "7.2.9",
    "cacheable": "2.5.0",
    "drizzle-orm": "1.0.0-rc.4",
    "fastify": "5.12.5",
    "keyv": "5.6.0",
    "nest-winston": "2.0.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "passport-local": "1.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "winston": "3.19.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@nestjs/cli": "12.0.0",
    "@nestjs/schematics": "12.0.0",
    "@nestjs/testing": "12.1.0",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.2",
    "@types/bun": "1.4.2",
    "@types/passport-jwt": "4.0.1",
    "@types/passport-local": "1.0.38",
    "@vitest/coverage-v8": "5.0.2",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint-plugin-perfectionist": "5.12.1",
    "lint-staged": "17.6.0",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "simple-git-hooks": "^2.14.0",
    "source-map-support": "0.5.21",
    "typescript": "6.0.2",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.2"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": "oxlint --fix",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "packageManager": "bun@1.4.2"
}
